generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Chambre {
  id Int @id @default(autoincrement())
  hotelId Int @map("hotel_id")
  numero String
  categorie String
  capacite Int
  prixNuit Int @map("prix_nuit")
  description String
  disponible Boolean @default(true)

  hotel       Hotel         @relation(fields: [hotelId], references: [id])
  reservations Reservation[]
  
  @@map("chambres")
}

model Hotel {
  id           Int      @id @default(autoincrement())
  nom          String
  etoiles      Int
  adresse      String
  codePostal   String   @map("code_postal")
  ville        String
  telephone    String
  email        String
  gerant       String
  description  String
  
  // Relation avec le modèle Chambre
  chambre     Chambre[]

  @@map("hotels")
}

model Compte {
  id               Int    @id @default(autoincrement())
  role             String
  email            String @unique
  telephone        String? @unique
  motDePasseClair  String @map("mot_de_passe_clair")
  nom              String
  prenom           String
  hotelId          Int?   @map("hotel_id")
  note             String?


  @@map("comptes")
}

model Reservation {
  id              Int      @id @default(autoincrement())
  voyageurId      Int      @map("voyageur_id")
  chambreId       Int      @map("chambre_id")
  dateArrivee     DateTime @map("date_arrivee") @db.Date
  dateDepart      DateTime @map("date_depart") @db.Date
  nbPersonnes     Int      @map("nb_personnes")
  statut          String
  demandeSpeciale String?  @map("demande_speciale")

  // Relation avec le modèle Chambre
  chambre         Chambre  @relation(fields: [chambreId], references: [id])

  @@map("reservations")
}